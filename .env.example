# ========================================================
# SelfHeal Storage Environment Variables
# ========================================================

# MongoDB connection URI (falls back gracefully to embedded storage if MongoDB is not running)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=selfheal_storage

# Storage Path on Local Filesystem for replica bytes
STORAGE_PATH=storage_data

# Predictive Health Monitoring & Heartbeat Configuration
HEARTBEAT_INTERVAL_SECONDS=3.0
SLIDING_WINDOW_SIZE=10
BETA_WEIGHT=0.60
SLOPE_REF_MS_PER_SEC=8.0
MISSED_HB_MAX=4
RISK_WARNING_THRESHOLD=0.35
RISK_CRITICAL_THRESHOLD=0.70
MAX_MISSED_HB_FAILSTOP=4

# Placement Algorithm Configuration
WEIGHT_LOAD=0.50
WEIGHT_DIVERSITY=0.50
WEIGHT_CPU=0.35
WEIGHT_IO=0.35
WEIGHT_STORAGE=0.30
EXCLUDE_AT_RISK_NODES=true

# Adaptive Replication Engine Configuration
DEFAULT_STANDARD_REPLICAS=3
DEFAULT_CRITICAL_REPLICAS=4
MIN_REPLICAS=2
MAX_REPLICAS=5
DORMANT_THRESHOLD_SECONDS=120.0
HIGH_ACCESS_THRESHOLD_RPS=2.0

# Security & Upload Configuration
MAX_UPLOAD_SIZE_MB=50
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

